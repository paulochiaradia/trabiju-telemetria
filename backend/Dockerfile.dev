# backend/Dockerfile.dev - Para desenvolvimento com hot reload

FROM golang:1.21

# Diretório de trabalho dentro do container
WORKDIR /app

# Copia go.mod e go.sum primeiro para cache de dependências
COPY go.mod go.sum ./

# Baixa as dependências
RUN go mod download

# Instala air para hot reload (versão compatível com Go 1.21)
RUN go install github.com/cosmtrek/air@v1.49.0

# Copia todo o código fonte (será sobrescrito pelo volume mount em desenvolvimento)
COPY . .

# Torna o script executável
RUN chmod +x start-dev.sh

# Cria o diretório tmp se não existir e compila uma primeira vez
RUN mkdir -p tmp && go build -o ./tmp/trabiju ./cmd

# Expõe a porta usada pelo Gin
EXPOSE 8080

# Comando para executar o projeto em modo desenvolvimento com hot reload
CMD ["./start-dev.sh"]
