# ========================
# DATABASE CONFIGURATION
# ========================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_NAME=trabiju_telemetria

# ========================
# JWT CONFIGURATION
# ========================
JWT_SECRET=seu-jwt-secret-super-seguro-mude-em-producao
JWT_EXPIRY_HOURS=24

# ========================
# EMAIL/SMTP CONFIGURATION
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app-gmail
FROM_EMAIL=noreply@gestaotelemetria.com
FROM_NAME=Gestão Telemetria

# ========================
# APPLICATION CONFIGURATION
# ========================
ENVIRONMENT=development
PORT=8080
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@gestaotelemetria.com

# ========================
# MYSQL CONFIGURATION (para docker)
# ========================
MYSQL_ROOT_PASSWORD=sua_senha_mysql
MYSQL_DATABASE=trabiju_telemetria
MYSQL_USER=user
MYSQL_PASSWORD=sua_senha_mysql

# ========================
# SECURITY (opcional)
# ========================
TRUSTED_PROXIES=127.0.0.1,::1
