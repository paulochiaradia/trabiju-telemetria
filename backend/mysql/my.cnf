[mysqld]
# Configurações para resolver warnings do MySQL 8.0

# 1. Resolver warning: The syntax '--skip-host-cache' is deprecated
host_cache_size=0
skip-name-resolve=1

# 2. Resolver warning: CA certificate ca.pem is self signed
# Desabilitar SSL para ambiente de desenvolvimento
skip-ssl=1

# 3. Resolver warning: Insecure configuration for --pid-file
pid-file=/var/lib/mysql/mysqld.pid

# 4. Configurações de timezone
default-time-zone='+00:00'
log_timestamps=SYSTEM

# 5. Configurações de charset para evitar warnings
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# 6. Reduzir verbosidade dos logs (1=ERROR, 2=ERROR+WARNING, 3=ERROR+WARNING+INFO)
log-error-verbosity=1

# 7. Desabilitar X Plugin se não for usado (remove warning sobre porta 33060)
mysqlx=OFF

# 8. Configurações de performance otimizadas
innodb_buffer_pool_size=256M
max_connections=100
innodb_flush_log_at_trx_commit=2
innodb_file_per_table=1

# 9. Configurações de segurança
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO

[mysql]
default-character-set=utf8mb4

[client]
default-character-set=utf8mb4
