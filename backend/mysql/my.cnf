[mysqld]
# Resolver warning: The syntax '--skip-host-cache' is deprecated
host_cache_size=0
skip-name-resolve=1

# Resolver warning: CA certificate ca.pem is self signed
# Desabilitar SSL para desenvolvimento (mais seguro usar em produção)
skip-ssl

# Resolver warning: Insecure configuration for --pid-file
pid-file=/var/lib/mysql/mysqld.pid

# Configurações de timezone para reduzir warnings
default-time-zone='+00:00'
log_timestamps=SYSTEM

# Configurações de charset
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Reduzir verbosidade dos logs
log-error-verbosity=2

# Configurações de performance para desenvolvimento
innodb_buffer_pool_size=128M
max_connections=100

# Desabilitar X Plugin para reduzir warnings (se não for usado)
# mysqlx=OFF

[mysql]
default-character-set=utf8mb4

[client]
default-character-set=utf8mb4
